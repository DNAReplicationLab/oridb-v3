# Not reachable over HTTP. The application reads these files from disk;
# the published copies are generated by export.php and by the release archive. Both directive styles are present so
# this works on Apache 2.2, Apache 2.4 and LiteSpeed.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
